# SafeRoute — Environment Configuration
# Copy this to .env and fill in your values

# Flask
FLASK_APP=app
FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-string

# Groq AI (get free key at console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Maps API (for Places, Directions, etc.)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Twilio SMS (for emergency alerts to guardians)
# Get credentials at https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Database
DATABASE_URL=sqlite:///saferoute.db

# Map Configuration
DEFAULT_LAT=26.9124
DEFAULT_LNG=75.7873
DEFAULT_ZOOM=13
CITY_NAME=Jaipur

# Feature Flags
ENABLE_NIGHT_MODE=true
ENABLE_SCHOOL_MODE=true
ENABLE_EMERGENCY=true
ENABLE_COMMUNITY_REPORTS=true
ENABLE_AI_EXPLANATIONS=true
